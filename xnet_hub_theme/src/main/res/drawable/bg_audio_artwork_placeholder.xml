<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#17351D"
                android:endColor="#030603"
                android:gradientRadius="196dp"
                android:startColor="#0A120B"
                android:type="radial" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#081109"
                android:endColor="#00000000"
                android:gradientRadius="130dp"
                android:startColor="#00000000"
                android:type="radial" />
        </shape>
    </item>

    <item
        android:bottom="18dp"
        android:left="18dp"
        android:right="18dp"
        android:top="18dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:centerColor="#1E204A28"
                android:endColor="#00000000"
                android:startColor="#2600FF41" />
        </shape>
    </item>
</layer-list>
