<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ========================================= -->
    <!-- BASE THEME FOR ALL XNET APPS              -->
    <!-- ========================================= -->
    <style name="Theme.XnetCore.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">?attr/xnetBackground</item>
        <item name="android:navigationBarColor">?attr/xnetBackground</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        
        <item name="xnetEnableAnimatedBackdrop">false</item>
        <item name="xnetIsCyberTheme">false</item>

        <!-- Base Backgrounds -->
        <item name="xnetBackground">#121212</item>
        <item name="xnetBackgroundAlt">#000000</item>
        <item name="xnetBackgroundDeep">#080808</item>

        <!-- Surfaces -->
        <item name="xnetSurfaceBase">#1E1E1E</item>
        <item name="xnetSurfaceAlt">#242424</item>
        <item name="xnetSurfaceRaised">#2C2C2C</item>
        <item name="xnetSurfaceFloat">#333333</item>

        <!-- Strokes -->
        <item name="xnetStroke">#444444</item>
        <item name="xnetStrokeSoft">#25FFFFFF</item>

        <!-- Text Colors -->
        <item name="xnetTextPrimary">#FFFFFF</item>
        <item name="xnetTextSecondary">#B3B3B3</item>
        <item name="xnetTextMuted">#808080</item>
        <item name="xnetTextHint">#666666</item>

        <!-- Accent Colors -->
        <item name="xnetAccentPrimary">#00FF41</item>
        <item name="xnetAccentPrimarySoft">#4000FF41</item>
        <item name="xnetAccentHighlight">#00D4FF</item>
        <item name="xnetAccentHighlightSoft">#4000D4FF</item>
        <item name="xnetAccentPositive">#00FF85</item>

        <!-- Glass & Overlay defaults -->
        <item name="xnetGlass">#20FFFFFF</item>
        <item name="xnetGlassSoft">#12FFFFFF</item>
        <item name="xnetBackdropGrid">#15FFFFFF</item>
        <item name="xnetScrim">#A0000000</item>

        <!-- Widget Styles -->
        <item name="materialButtonStyle">@style/Widget.XnetCore.Button</item>
        <item name="materialCardViewStyle">@style/Widget.XnetCore.Card</item>
        <item name="popupMenuStyle">@style/Widget.XnetCore.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.XnetCore.PopupMenu</item>

        <!-- Dynamic Shapes for Normal Themes (Rounded) -->
        <item name="xnetShapeButton">@style/ShapeAppearanceOverlay.XnetCore.CutButton.Classic</item>
        <item name="xnetShapeCard">@style/ShapeAppearanceOverlay.XnetCore.CutCard.Classic</item>
        <item name="xnetShapeInput">@style/ShapeAppearanceOverlay.XnetCore.CutButton.Classic</item>
        <item name="xnetShapeDrawerShell">@style/ShapeAppearanceOverlay.XnetCore.DrawerShell.Classic</item>
        <item name="xnetShapeDrawerProfile">@style/ShapeAppearanceOverlay.XnetCore.DrawerProfile.Classic</item>
        <item name="xnetShapeSpinnerDrawable">@drawable/bg_xnet_spinner_shell_classic</item>
    </style>

    <!-- ========================================= -->
    <!-- 1. LIGHT THEME (Normal Standard)          -->
    <!-- ========================================= -->
    <style name="Theme.XnetCore.Light" parent="Theme.XnetCore.Base">
        <!-- Colors -->
        <item name="xnetBackground">@color/classic_light_background</item>
        <item name="xnetBackgroundAlt">@color/white</item>
        <item name="xnetSurfaceBase">@color/classic_light_surface</item>
        <item name="xnetTextPrimary">@color/classic_light_text_primary</item>
        <item name="xnetTextSecondary">@color/classic_light_text_secondary</item>
        <item name="xnetTextMuted">#757575</item>
        <item name="xnetTextHint">#9E9E9E</item>
        <item name="xnetAccentPrimary">@color/classic_light_accent</item>
        <item name="xnetAccentPositive">#2E7D32</item>
        <item name="xnetSurfaceRaised">#E0E0E0</item>
        <item name="xnetSurfaceAlt">#FFFFFF</item>
        <item name="xnetStroke">#CCCCCC</item>
        <item name="xnetStrokeSoft">#1F000000</item>
        <item name="xnetGlass">#15000000</item>
        <item name="xnetGlassSoft">#08000000</item>
        <item name="xnetAccentPrimarySoft">#20000000</item>
        
        <!-- Standard Material Color Assignments -->
        <item name="colorPrimary">@color/classic_light_accent</item>
        <item name="colorPrimaryVariant">@color/classic_light_surface</item>
        <item name="colorOnPrimary">@color/classic_light_background</item>
        <item name="colorSecondary">@color/classic_light_accent</item>
        <item name="colorSecondaryVariant">@color/classic_light_accent</item>
        <item name="colorOnSecondary">@color/classic_light_background</item>
        <item name="colorSurface">@color/classic_light_surface</item>
        <item name="android:colorBackground">@color/classic_light_background</item>
        <item name="colorOnSurface">@color/classic_light_text_primary</item>
        
        <!-- Standard Material Fonts & Shapes -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Legacy Alias -->
    <style name="Theme.XnetCore.Classic.Light" parent="Theme.XnetCore.Light" />

